# ── IntelliRAG Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values

# LLM Model (runs locally via Ollama — no internet needed after pull)
OLLAMA_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text

# Database
POSTGRES_USER=intellirag
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=intellirag

# Object Storage (MinIO — runs on-premise)
MINIO_ROOT_USER=intellirag
MINIO_ROOT_PASSWORD=change_me_strong_password

# App Security
SECRET_KEY=change-me-to-a-random-32-char-string!!

# CORS — restrict to your portal domain in production
# Example: CORS_ORIGINS=https://myacl.acldigital.com,https://portal.acldigital.com
CORS_ORIGINS=*
